rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function existing() {
      return resource.data;
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidLeaderboardEntry(data) {
      return data.userId is string
        && data.userId.size() >= 1
        && data.userId.size() <= 128
        && data.displayName is string
        && data.displayName.size() >= 1
        && data.displayName.size() <= 40
        && data.totalSatsMined is int
        && data.totalSatsMined >= 0
        && data.totalSatsMined <= 2100000000000000
        && data.totalBtcMined is number
        && data.totalBtcMined >= 0.0
        && data.totalBtcMined <= 21000000.0
        && data.hashRateGh is number
        && data.hashRateGh >= 0.0
        && data.hashRateGh <= 1000000000.0
        && data.activeMiners is int
        && data.activeMiners >= 0
        && data.activeMiners <= 1000
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /leaderboard/{userId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn() && resource.data.totalSatsMined >= 0;

      allow create: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == request.auth.uid
        && incoming().keys().hasAll([
          'userId',
          'displayName',
          'totalSatsMined',
          'totalBtcMined',
          'hashRateGh',
          'activeMiners',
          'createdAt',
          'updatedAt'
        ])
        && incoming().keys().hasOnly([
          'userId',
          'displayName',
          'totalSatsMined',
          'totalBtcMined',
          'hashRateGh',
          'activeMiners',
          'createdAt',
          'updatedAt'
        ])
        && isValidLeaderboardEntry(incoming());

      allow update: if isOwner(userId)
        && isValidId(userId)
        && incoming().userId == request.auth.uid
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName',
          'totalSatsMined',
          'totalBtcMined',
          'hashRateGh',
          'activeMiners',
          'updatedAt'
        ])
        && isValidLeaderboardEntry(incoming());

      allow delete: if isOwner(userId);
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
